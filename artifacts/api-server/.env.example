# PrimeOpp API Server - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# Boot-time validation lives in src/lib/env.ts (zod schema) - the server
# will refuse to start if any REQUIRED variable below is missing/invalid.

# --- REQUIRED (server exits at boot if any of these are missing/invalid) ---

# Postgres connection string. Schema is defined in lib/db/migrations/*.sql
# but there is currently no migration runner wired up - see
# PRIMEOPP_LAUNCH_BLOCKERS.md for status before pointing this at a real DB.
DATABASE_URL=

# Session cookie signing secret. Must be 32+ characters.
SESSION_SECRET=

# Seed admin account used by the admin login flow (routes/auth.ts).
ADMIN_EMAIL=
# Must be 12+ characters.
ADMIN_PASSWORD=

# Stripe Checkout - required for /api/checkout/session to return anything
# other than 503. Use a TEST mode secret key for local/dev work.
STRIPE_SECRET_KEY=
# Required to verify the Stripe webhook signature (routes/orders.ts). In
# production the webhook handler hard-fails closed if this is unset.
STRIPE_WEBHOOK_SECRET=

# --- OPTIONAL ---

# CORS allowlist, comma-separated origins (app.ts). If unset, no
# cross-origin requests are allowed.
ALLOWED_ORIGINS=

# Fulfillment provider API keys. If unset, fulfillment.ts logs a warning
# and skips that provider rather than failing the order.
PRINTFUL_API_KEY=
TAPSTITCH_API_KEY=

# Transactional email (order confirmations, etc). If unset, email.ts logs
# a warning and skips sending rather than failing the order.
RESEND_API_KEY=
FROM_EMAIL=orders@primeopp.com

# Standard Node environment flag; affects webhook-signature enforcement
# strictness in routes/orders.ts.
NODE_ENV=development
