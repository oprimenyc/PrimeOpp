# PrimeOpp Product Intake - Environment Configuration
# Copy this file to .env and fill in values as needed.
# This module has NO required runtime secrets for core functionality.

# Optional: External lookup provider API key (for future enrichment integration)
# PRIMEOPP_LOOKUP_API_KEY=

# Optional: Logging level (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Optional: Max batch size for batch intake operations
# MAX_BATCH_SIZE=500