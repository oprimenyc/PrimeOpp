{
  "name": "primeopp-product-intake",
  "version": "1.0.0",
  "description": "Normalize and validate product intake from barcode scans, identifiers, manual entry, and batch input.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:verbose": "jest --config jest.config.js --verbose",
    "lint": "eslint src/ tests/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "barcode",
    "upc",
    "ean",
    "gtin",
    "isbn",
    "product-intake",
    "primeopp",
    "normalization",
    "validation"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}