# Environment variables for affiliate-backlink-engine
# Copy to .env and fill in only the providers you actually use.
# The engine is fully functional in fixture/import mode with NO env vars set.

# --- Search providers (optional) ---
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- SEO backlink providers (optional) ---
SEO_PROVIDER=none
SEO_API_KEY=

# --- LLM providers (optional, used only for classification/drafting assistance) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- Contact data providers (optional) ---
CONTACT_PROVIDER=none
CONTACT_API_KEY=

# --- Crawl provider (optional) ---
CRAWL_PROVIDER=none
CRAWL_API_KEY=

# --- Runtime safety ---
MAX_IMPORT_ROWS=50000
MAX_FETCH_URLS_PER_RUN=200
DEFAULT_TIMEOUT_MS=15000
DRY_RUN=true
