{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primeopp Canonical Listing",
  "type": "object",
  "required": ["id", "productId", "title", "tenantId", "price", "quantity", "condition", "selectedChannels", "alsoListOnPrimeOppMarketplace", "state"],
  "properties": {
    "id": { "type": "string" },
    "productId": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "price": {
      "type": "object",
      "required": ["amount", "acceptOffers"],
      "properties": {
        "amount": { "$ref": "money.schema.json" },
        "minimumOffer": { "$ref": "money.schema.json" },
        "acceptOffers": { "type": "boolean" }
      }
    },
    "quantity": { "type": "integer", "minimum": 0 },
    "condition": { "type": "string", "enum": ["NEW", "NEW_WITH_TAGS", "NEW_WITHOUT_TAGS", "NEW_OPEN_BOX", "LIKE_NEW", "EXCELLENT", "VERY_GOOD", "GOOD", "FAIR", "POOR", "FOR_PARTS", "REFURBISHED", "SELLER_REFURBISHED", "MANUFACTURER_REFURBISHED", "DAMAGED", "CUSTOM"] },
    "selectedChannels": { "type": "array", "items": { "type": "string" } },
    "alsoListOnPrimeOppMarketplace": { "type": "boolean" },
    "state": { "type": "string", "enum": ["DRAFT", "READY", "APPROVAL_REQUIRED", "APPROVED", "PUBLISHING", "ACTIVE", "PAUSED", "SOLD", "ENDED", "ERROR", "NEEDS_ATTENTION", "ARCHIVED"] }
  }
}
