# ---------------------------------------------------------------------------
# primeopp-product-enrichment — environment example
# ---------------------------------------------------------------------------
# This module is provider-neutral and ships with fixture-based providers that
# require NO external credentials. The HTTP adapter and ISBN adapter templates
# are designed to be wired to real providers by the integrating host.
#
# Copy this file to `.env` (or export the variables in your host runtime) ONLY
# if you intend to enable an external provider. The fixture and manual
# providers always work without any environment configuration.
# ---------------------------------------------------------------------------

# Generic HTTP product provider (DISABLED by default).
# Set to "true" to enable. Without enabling, the adapter is registered but
# will return a structured "provider-disabled" result for any enrich() call.
PRIMEOPP_ENRICH_HTTP_PROVIDER_ENABLED=false

# Base URL for the external product data API. Never include credentials in
# the URL. Use the *_API_KEY variable below.
PRIMEOPP_ENRICH_HTTP_PROVIDER_BASE_URL=

# API key / bearer token for the HTTP provider. Loaded at runtime by the
# integrating host and passed via the adapter config — NOT read from process.env
# by the core module. This variable documents the recommended convention only.
PRIMEOPP_ENRICH_HTTP_PROVIDER_API_KEY=

# Default per-provider timeout in milliseconds.
PRIMEOPP_ENRICH_PROVIDER_TIMEOUT_MS=5000

# Maximum number of providers the orchestrator will consult per enrichment.
PRIMEOPP_ENRICH_MAX_PROVIDERS=5

# Cache TTL in seconds for enriched profiles written to the in-memory cache.
PRIMEOPP_ENRICH_CACHE_TTL_SECONDS=300
