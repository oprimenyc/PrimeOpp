{
  "name": "primeopp-deal-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented, reusable deal intelligence platform (PrimeOpp).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --reporter=default",
    "lint": "node scripts/lint.js",
    "verify": "node scripts/verify.js",
    "package": "node scripts/package.js",
    "cleanroom-verify": "node scripts/cleanroom-verify.js",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
